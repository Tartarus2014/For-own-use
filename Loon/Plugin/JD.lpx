#!name = 京东比价
#!desc = 京东App历史价格（商品详情页面）表格折线版
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(984)
#!openUrl = https://apps.apple.com/cn/app/id414245413
#!icon = https://raw.githubusercontent.com/Tartarus2014/For-own-use/refs/heads/master/Color/JD.png
#!arguments-desc = [参数设置]\n1. MMMCK_SCRIPT:慢慢买CK 脚本前往慢慢买App获取Cookie\n2.避免不必要的重写，禁用请设置为"#"

[Argument]
MMMCK_SCRIPT=input,慢慢买CK,tag=MMMCK_SCRIPT, desc=MMMCK_SCRIPT

[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js") with tag="{MMMCK_SCRIPT}", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js") with tag="京东比价", timeout=60, requires_body=true

[MITM]
hostname = in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
